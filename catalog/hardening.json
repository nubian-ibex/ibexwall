    {
      "id": "kernel.kexec",
      "area": "kernel",
      "risk": "medium",
      "recommended": false,
      "title": {
        "en": "Forbid loading another kernel while running",
        "pt-BR": "Proibir carregar outro kernel em execução"
      },
      "summary": {
        "en": "Closes a way for an attacker with administrator rights to switch to a kernel they prepared.",
        "pt-BR": "Fecha um caminho para um atacante com direitos de administrador trocar para um kernel que ele preparou."
      },
      "breaks": {
        "en": "Cannot be undone until the next restart. Tools that rely on kexec (fast reboot, crash dumps) stop working.",
        "pt-BR": "Não pode ser desfeito até a próxima reinicialização. Ferramentas que usam kexec (reinício rápido, dumps de falha) deixam de funcionar."
      },
      "sources": [
        {
          "name": "Linux Hardening Guide (madaidans)",
          "section": "2.2.1",
          "url": "https://madaidans-insecurities.github.io/guides/linux-hardening.html#sysctl-kernel"
        },
        {
          "name": "Linux kernel documentation",
          "section": "kernel.kexec_load_disabled",
          "url": "https://docs.kernel.org/admin-guide/sysctl/index.html"
        }
      ],
      "probe": {
        "kind": "sysctl",
        "keys": [
          {
            "key": "kernel.kexec_load_disabled",
            "want": "1",
            "at_least": false
          }
        ]
      },
      "apply": {
        "plugin": "system.sysctl",
        "patch": {
          "keys": {
            "kernel.kexec_load_disabled": "1"
          }
        }
      },
      "doc": "kernel.kexec"
    },

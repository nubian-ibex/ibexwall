      "probe": {
        "kind": "sysctl",
        "keys": [
          {
            "key": "kernel.perf_event_paranoid",
            "want": "2",
            "at_least": true
          }
        ]
      },
      "apply": {
        "plugin": "system.sysctl",
        "patch": {
          "keys": {
            "kernel.perf_event_paranoid": "2"
          }
        }
      },
      "doc": "kernel.perf-events"

    {
      "id": "kernel.ptrace",
      "area": "kernel",
      "risk": "medium",
      "recommended": true,
      "title": {
        "en": "Limit one program inspecting another",
        "pt-BR": "Limitar um programa que inspeciona outro"
      },
      "summary": {
        "en": "A program may only attach to its own children, so malware in your session cannot read or change your other programs.",
        "pt-BR": "Um programa só pode se anexar aos próprios filhos, então um malware na sua sessão não lê nem altera seus outros programas."
      },
      "breaks": {
        "en": "Attaching a debugger (gdb, strace) to a program that is already running needs administrator rights.",
        "pt-BR": "Anexar um depurador (gdb, strace) a um programa já em execução exige direitos de administrador."
      },
      "sources": [
        {
          "name": "Linux Hardening Guide (madaidans)",

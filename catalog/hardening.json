    {
      "id": "kernel.perf-events",
      "area": "kernel",
      "risk": "medium",
      "recommended": false,
      "title": {
        "en": "Restrict performance events",
        "pt-BR": "Restringir os eventos de desempenho"
      },
      "summary": {
        "en": "Profiling hooks add a lot of kernel code that ordinary users can reach. This limits most of it to administrators.",
        "pt-BR": "Os ganchos de profiling acrescentam muito código do kernel ao alcance de usuários comuns. Isto limita a maior parte aos administradores."
      },
      "breaks": {
        "en": "Developers can no longer profile their own programs with perf without extra rights.",
        "pt-BR": "Desenvolvedores deixam de perfilar os próprios programas com o perf sem direitos extras."
      },

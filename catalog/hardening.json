  "items": [
    {
      "id": "kernel.kptr-restrict",
      "area": "kernel",
      "risk": "low",
      "recommended": true,
      "title": {
        "en": "Hide kernel addresses",
        "pt-BR": "Esconder endereços do kernel"
      },
      "summary": {
        "en": "Programs without special rights can no longer read where things sit in kernel memory. Attackers use those addresses to aim exploits.",
        "pt-BR": "Programas sem direitos especiais deixam de ler onde as coisas ficam na memória do kernel. Atacantes usam esses endereços para mirar explorações."
      },
      "breaks": null,
      "sources": [
        {
          "name": "Linux Hardening Guide (madaidans)",
          "section": "2.2.1",
          "url": "https://madaidans-insecurities.github.io/guides/linux-hardening.html#sysctl-kernel"
        },
        {
          "name": "Linux kernel documentation",
          "section": "kernel.kptr_restrict",
          "url": "https://docs.kernel.org/admin-guide/sysctl/index.html"
        }
      ],
      "probe": {
        "kind": "sysctl",
        "keys": [
          {
            "key": "kernel.kptr_restrict",
            "want": "2",
            "at_least": false
          }
        ]
      },
      "apply": {
        "plugin": "system.sysctl",
        "patch": {
          "keys": {
            "kernel.kptr_restrict": "2"
          }
        }
      },
      "doc": "kernel.kptr-restrict"
    },
    {
      "id": "kernel.dmesg-restrict",
      "area": "kernel",
      "risk": "low",
      "recommended": true,
      "title": {
        "en": "Keep the kernel log for administrators",
        "pt-BR": "Deixar o log do kernel só para administradores"
      },
      "summary": {
        "en": "The kernel log can reveal addresses and hardware details. Only an administrator may read it.",
        "pt-BR": "O log do kernel pode revelar endereços e detalhes do hardware. Só um administrador pode lê-lo."

          "url": "https://madaidans-insecurities.github.io/guides/linux-hardening.html#sysctl-userspace"
        },
        {
          "name": "Linux kernel documentation, Yama",
          "section": "ptrace_scope",
          "url": "https://docs.kernel.org/admin-guide/LSM/Yama.html"
        }
      ],
      "probe": {
        "kind": "sysctl",
        "keys": [
          {
            "key": "kernel.yama.ptrace_scope",
            "want": "1",
            "at_least": true
          }
        ]
      },
      "apply": {
        "plugin": "system.sysctl",
        "patch": {
          "keys": {
            "kernel.yama.ptrace_scope": "1"
          }
        }
      },
      "doc": "kernel.ptrace"
    },
    {
      "id": "kernel.user-namespaces",
      "area": "kernel",
      "risk": "high",
      "recommended": false,
      "title": {
        "en": "Turn off unprivileged sandboxes (user namespaces)",
        "pt-BR": "Desligar sandboxes sem privilégio (user namespaces)"
      },
      "summary": {
        "en": "User namespaces give ordinary programs a lot of kernel code to attack. Turning them off removes a large part of the surface.",
        "pt-BR": "Os user namespaces dão aos programas comuns muito código do kernel para atacar. Desligá-los remove boa parte da superfície."
      },
      "breaks": {
        "en": "Flatpak, the Chromium and Firefox sandboxes, rootless containers and many AppImages stop working.",
        "pt-BR": "Flatpak, os sandboxes do Chromium e do Firefox, contêineres sem root e muitos AppImages deixam de funcionar."
      },

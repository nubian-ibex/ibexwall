          "section": "kernel.dmesg_restrict",
          "url": "https://docs.kernel.org/admin-guide/sysctl/index.html"
        }
      ],
      "probe": {
        "kind": "sysctl",
        "keys": [
          {
            "key": "kernel.dmesg_restrict",
            "want": "1",
            "at_least": false
          }
        ]
      },
      "apply": {
        "plugin": "system.sysctl",
        "patch": {
          "keys": {
            "kernel.dmesg_restrict": "1"
          }
        }
      },
      "doc": "kernel.dmesg-restrict"
    },
    {
      "id": "kernel.unprivileged-bpf",
      "area": "kernel",
      "risk": "medium",
      "recommended": true,
      "title": {
        "en": "Restrict eBPF to administrators",
        "pt-BR": "Restringir o eBPF a administradores"
      },
      "summary": {
        "en": "eBPF lets programs run code inside the kernel and has been a steady source of flaws. This limits it to privileged programs and hardens its compiler.",
        "pt-BR": "O eBPF deixa programas executar código dentro do kernel e é fonte constante de falhas. Isto o limita a programas privilegiados."
      },
      "breaks": {
        "en": "Tools that load eBPF without privileges stop working. IbexWall itself is not affected.",
        "pt-BR": "Ferramentas que carregam eBPF sem privilégios deixam de funcionar. O próprio IbexWall não é afetado."
      },
      "sources": [
        {
          "name": "Linux Hardening Guide (madaidans)",
          "section": "2.2.1",
          "url": "https://madaidans-insecurities.github.io/guides/linux-hardening.html#sysctl-kernel"
        },
        {
          "name": "Linux kernel documentation",
          "section": "kernel.unprivileged_bpf_disabled",
          "url": "https://docs.kernel.org/admin-guide/sysctl/index.html"
        }
      ],
      "probe": {
        "kind": "sysctl",
        "keys": [
          {
            "key": "kernel.unprivileged_bpf_disabled",
            "want": "1",
            "at_least": true
          }
        ]
      },
      "apply": {
        "plugin": "system.sysctl",
        "patch": {
          "keys": {
            "kernel.unprivileged_bpf_disabled": "1"
          }
        }
      },
      "doc": "kernel.unprivileged-bpf"
    },
    {

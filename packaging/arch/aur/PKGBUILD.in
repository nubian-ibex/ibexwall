#
# Maintainer: Nubian Ibex <maintainers@nubian-ibex.invalid>
#
# Generated by `cargo xtask aur`; change the template, not this file.
# Installs the files of the packages in the official release, which are built
# from the tag v$pkgver and listed in its signed SHA256SUMS (docs/release.md).

pkgbase=ibexwall-bin
pkgname=(ibexwall-bin ibexwall-desktop-bin ibexwall-mcp-bin)
pkgver=@VERSION@
pkgrel=@PKGREL@
arch=(x86_64)
url=https://github.com/nubian-ibex/ibexwall
license=(GPL-3.0-or-later)
options=(!strip !debug)
source=("$url/releases/download/v$pkgver/ibexwall-$pkgver-1-x86_64.pkg.tar.zst"
        "$url/releases/download/v$pkgver/ibexwall-desktop-$pkgver-1-x86_64.pkg.tar.zst"
        "$url/releases/download/v$pkgver/ibexwall-mcp-$pkgver-1-x86_64.pkg.tar.zst")
noextract=("${source[@]##*/}")
sha256sums=('@SHA256_CORE@'
            '@SHA256_DESKTOP@'
            '@SHA256_MCP@')

# Copies a release package's files, without its pacman metadata.
_repack() {
    bsdtar -xf "$srcdir/$1-$pkgver-1-x86_64.pkg.tar.zst" -C "$pkgdir" \
        --exclude .BUILDINFO --exclude .INSTALL --exclude .MTREE --exclude .PKGINFO
}

package_ibexwall-bin() {
    pkgdesc='Security center for Linux: daemon, command line, resolver and plugins'
    depends=(nftables polkit systemd)
    optdepends=('chrony: authenticated time (NTS)' 'ufw: firewall manager' 'firewalld: firewall manager')
    provides=("ibexwall=$pkgver")
    conflicts=(ibexwall)
    install=ibexwall.install
    _repack ibexwall
}

package_ibexwall-desktop-bin() {
    pkgdesc='IbexWall desktop app and session agent'
    depends=("ibexwall-bin=$pkgver-$pkgrel" webkit2gtk-4.1 gtk3)
    optdepends=('libayatana-appindicator: tray icon')
    provides=("ibexwall-desktop=$pkgver")
    conflicts=(ibexwall-desktop)
    _repack ibexwall-desktop
}

package_ibexwall-mcp-bin() {
    pkgdesc='IbexWall MCP server for AI assistants'
    depends=("ibexwall-bin=$pkgver-$pkgrel")
    provides=("ibexwall-mcp=$pkgver")
    conflicts=(ibexwall-mcp)
    _repack ibexwall-mcp
}

#!/bin/sh
set -e
case "$1" in
remove)
    # shellcheck disable=SC1091
    . /usr/lib/ibexwall/package-scripts.sh
    # Unloading a profile leaves its processes unconfined. Restarting them
    # here would only ask systemd for a profile that is gone, and log it.
    apparmor_remove
    ;;
esac
exit 0

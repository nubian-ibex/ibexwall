[Unit]
Description=IbexWall session agent
Documentation=https://docs.ibexwall.com
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ibexwall-agent
Restart=on-failure
# Session-scope hardening: the agent reads the user's own files only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=graphical-session.target

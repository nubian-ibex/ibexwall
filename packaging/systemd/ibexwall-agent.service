[Unit]
Description=IbexWall session agent
Documentation=https://docs.ibexwall.com
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ibexwall-agent
Restart=on-failure
# Session-scope hardening: the agent reads the user's own files only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
# Not set on purpose: the agent starts the desktop app (--prompt) as a child
# of this unit, and its WebKit engine needs a JIT (no MemoryDenyWriteExecute),
# user namespaces for its own sandbox (no RestrictNamespaces) and a wide
# syscall set (no SystemCallFilter). Those belong on a unit without the UI.

[Install]
WantedBy=graphical-session.target

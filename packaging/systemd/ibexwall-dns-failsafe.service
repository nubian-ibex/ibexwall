[Unit]
Description=IbexWall secure DNS failsafe (restore the previous DNS configuration)
Documentation=https://ibexwall.org

[Service]
Type=oneshot
# Its own binary, so the SELinux policy can enter it in a permissive
# domain of its own (ibexwall-failsafe).
ExecStart=/usr/bin/ibexwall-dns-failsafe

# Needs to remove its drop-in and tell the system resolver or NetworkManager,
# nothing else.
NoNewPrivileges=yes
# CAP_NET_ADMIN and netlink only to delete IbexWall's own nftables chain.
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
MemoryDenyWriteExecute=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
UMask=0077
ProtectSystem=strict
# Only one of the two may exist on a machine.
ReadWritePaths=-/etc/systemd/resolved.conf.d -/etc/NetworkManager/conf.d
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

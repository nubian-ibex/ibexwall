[Unit]
Description=IbexWall secure DNS resolver
Documentation=https://ibexwall.org
After=network.target
# If the resolver cannot stay up, give the machine its previous DNS back.
OnFailure=ibexwall-dns-failsafe.service
StartLimitIntervalSec=60
# Every change of provider or list restarts the resolver on purpose, and a
# few close together must not look like a crash loop; five starts in a
# minute still does.
StartLimitBurst=5

[Service]
Type=exec
User=ibexwall-dns
ExecStart=/usr/bin/ibexwall-dns
Restart=on-failure
RestartSec=1

# Only the privilege to bind port 53 on loopback.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# The AppArmor profile of this name, where the machine uses AppArmor and has
# loaded it (ibexwall-apparmor); the leading dash ignores a machine without.
AppArmorProfile=-ibexwall-dns

# Reads /etc/ibexwall/dns/resolver.json; writes only its own block lists.
StateDirectory=ibexwall-dns
StateDirectoryMode=0750
# Where the counters are published for the core (tmpfiles.d creates it).
ReadWritePaths=/run/ibexwall/dns
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target

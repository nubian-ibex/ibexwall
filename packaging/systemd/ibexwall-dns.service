[Unit]
Description=IbexWall secure DNS resolver
Documentation=https://ibexwall.org
After=network.target
# If the resolver cannot stay up, give the machine its previous DNS back.
OnFailure=ibexwall-dns-failsafe.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=ibexwall-dns
ExecStart=/usr/bin/ibexwall-dns
Restart=on-failure
RestartSec=1

# Only the privilege to bind port 53 on loopback.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Reads /etc/ibexwall/dns/resolver.json; writes only its own block lists.
StateDirectory=ibexwall/blocklists
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target

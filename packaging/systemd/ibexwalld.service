[Unit]
Description=IbexWall security daemon
Documentation=https://docs.ibexwall.com man:ibexwalld(8)
After=dbus.service polkit.service
Before=network-pre.target
Requires=ibexwalld.socket

[Service]
Type=notify
ExecStart=/usr/bin/ibexwalld
Restart=on-failure
WatchdogSec=30s
NoNewPrivileges=yes
# The AppArmor profile of this name, where the machine uses AppArmor and has
# loaded it (ibexwall-apparmor); the leading dash ignores a machine without.
AppArmorProfile=-ibexwalld
ProtectSystem=strict
# ADR-0026: /etc is written only by ibexwall-exec inside transient units
# whose ReadWritePaths match one transaction.
ReadWritePaths=/var/lib/ibexwall /run/ibexwall
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
# sysctl.set writes /proc/sys.
ProtectKernelTunables=no
# Reads cgroups for app identity (F4).
ProtectControlGroups=no
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_READ_SEARCH
StateDirectory=ibexwall
StateDirectoryMode=0750
RuntimeDirectory=ibexwall
RuntimeDirectoryPreserve=yes
ConfigurationDirectory=ibexwall
# Plans can carry secrets (a VPN profile's private key): nothing the
# daemon writes may be readable by another local user.
UMask=0077

[Install]
WantedBy=multi-user.target

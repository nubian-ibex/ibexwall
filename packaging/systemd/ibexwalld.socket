[Unit]
Description=IbexWall control socket

[Socket]
ListenStream=/run/ibexwall/core.sock
# World-connectable; every method is authorized through polkit.
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target

integrity-altered-title = An installed file is not what was shipped
integrity-altered-summary = { $path } does not match what the package manager installed. A changed program file is how malware stays in place; if you did not change it, reinstall the package that owns it.
integrity-added-title = A file AIDE did not expect
integrity-added-summary = AIDE reports { $count } added or changed files. Look at its report before trusting this machine.
integrity-more-title = And { $count } more
integrity-more-summary = { $count } more altered files were found. Run the check with --json to see them all.

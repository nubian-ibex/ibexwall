{
  "$defs": {
    "SystemSnapshot": {
      "additionalProperties": false,
      "description": "The numbers of the system snapshots taken around one change.",
      "properties": {
        "post": {
          "description": "Absent when the snapshot after the change failed.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pre": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pre"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Audit/history row.",
  "properties": {
    "actor": {
      "type": "string"
    },
    "plugin": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "seq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "system_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/SystemSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "transaction": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "ts": {
      "type": "string"
    }
  },
  "required": [
    "seq",
    "ts",
    "actor",
    "plugin",
    "result"
  ],
  "title": "HistoryEntry",
  "type": "object"
}

{
  "$defs": {
    "OpPreview": {
      "additionalProperties": false,
      "description": "One operation as previewed to the user (op kind + target + diff).",
      "properties": {
        "diff": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "op": {
          "type": "string"
        },
        "risk": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RiskFlag"
          },
          "type": "array"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "target"
      ],
      "type": "object"
    },
    "ProposalStatus": {
      "description": "Lifecycle of an AI/client proposal.",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "type": "string"
    },
    "Reversible": {
      "description": "How easily an operation reverses.",
      "enum": [
        "immediate",
        "reboot",
        "irreversible"
      ],
      "type": "string"
    },
    "RiskFlag": {
      "description": "Risk flags attached to plans and transactions (spec §4.5).",
      "enum": [
        "network",
        "auth",
        "boot",
        "reboot_to_revert",
        "irreversible"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A change proposed through the API (e.g. by the MCP assistant);\napproval is always human.",
  "properties": {
    "client": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "decided_at": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "justification": {
      "description": "Written by the AI: shown as generated, never as an instruction.",
      "type": "string"
    },
    "may_affect_keys": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "patch": {
      "description": "What the client asked for (the plugin's own patch)."
    },
    "plan_id": {
      "type": "string"
    },
    "plugin": {
      "type": "string"
    },
    "preview": {
      "description": "The operations the plan would run, as the human will review them.",
      "items": {
        "$ref": "#/$defs/OpPreview"
      },
      "type": "array"
    },
    "requires_confirm": {
      "type": "boolean"
    },
    "reversible": {
      "$ref": "#/$defs/Reversible"
    },
    "risk": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RiskFlag"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ProposalStatus"
    }
  },
  "required": [
    "id",
    "client",
    "plugin",
    "plan_id",
    "patch",
    "preview",
    "may_affect_keys",
    "reversible",
    "requires_confirm",
    "justification",
    "status",
    "created_at"
  ],
  "title": "Proposal",
  "type": "object"
}
